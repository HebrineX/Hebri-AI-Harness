{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hebrinex.runtime.layout",
  "title": "Hebri Runtime Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "contract_version", "runtime_api", "harness_version", "default_class", "roots", "integrity", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "hebrinex.runtime.layout" },
    "schema_version": { "const": 1 },
    "contract_version": { "const": "1.0.0" },
    "runtime_api": { "const": "1" },
    "harness_version": { "type": "string", "minLength": 1 },
    "default_class": { "const": "denied" },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["InstallRoot", "ProjectRoot", "InstanceRoot", "CatalogRoot"],
      "properties": {
        "InstallRoot": { "$ref": "#/$defs/root" },
        "ProjectRoot": { "$ref": "#/$defs/root" },
        "InstanceRoot": { "$ref": "#/$defs/root" },
        "CatalogRoot": { "$ref": "#/$defs/root" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_files"],
      "properties": {
        "required_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "consumer_write"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "consumer_write": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "logical_path", "class", "purpose", "root", "target_path", "read", "write", "legacy_projection"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" },
        "match": { "enum": ["exact", "prefix"] },
        "logical_path": { "type": "string", "minLength": 1 },
        "class": { "enum": ["product", "template", "instance", "integration", "catalog", "denied"] },
        "purpose": { "type": "string", "minLength": 1 },
        "root": { "enum": ["InstallRoot", "ProjectRoot", "InstanceRoot", "CatalogRoot", "none"] },
        "target_path": { "type": "string" },
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "legacy_projection": { "enum": ["shared", "instance", "excluded", "none"] }
      }
    }
  }
}
