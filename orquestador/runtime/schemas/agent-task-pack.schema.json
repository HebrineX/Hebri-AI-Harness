{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebri Agent Task Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "runtime_api", "task_id", "phase", "project_id", "actor_id", "role_id", "execution_mode", "status", "objective", "requirements", "invariants", "capabilities", "context", "budget", "approval", "tests", "stop_conditions", "expected_output"],
  "properties": {
    "schema": { "const": "hebrinex.agent_task_pack" },
    "contract_version": { "const": "1.0.0" },
    "runtime_api": { "const": "1" },
    "task_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "role_id": { "type": "string", "minLength": 1 },
    "execution_mode": { "enum": ["real_agent", "simulated_roles"] },
    "status": { "const": "ready" },
    "objective": { "type": "string", "minLength": 1 },
    "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "read_paths", "write_paths", "network", "process_execution", "elevation"],
      "properties": {
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "read_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "write_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "network": { "type": "boolean" },
        "process_execution": { "type": "boolean" },
        "elevation": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_policy", "cache_authority", "references"],
      "properties": {
        "selection_policy": { "const": "declared_only" },
        "cache_authority": { "const": false },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "reason", "trust", "required"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "reason": { "type": "string", "minLength": 1 },
              "trust": { "enum": ["harness_authority", "project_declared", "external_data", "provider_output"] },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_window_tokens", "host_reserved_tokens", "max_task_input_tokens", "max_output_tokens", "safety_margin_tokens", "estimated_input_tokens", "estimation_method"],
      "properties": {
        "context_window_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "host_reserved_tokens": { "type": "integer", "minimum": 0 },
        "max_task_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "safety_margin_tokens": { "type": "integer", "minimum": 0 },
        "estimated_input_tokens": { "type": "integer", "minimum": 0 },
        "estimation_method": { "enum": ["measured", "chars_div_4", "unknown"] }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "approval_id", "expires_at"],
      "properties": {
        "required": { "type": "boolean" },
        "approval_id": { "type": ["string", "null"] },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "path", "format"],
      "properties": {
        "schema": { "const": "hebrinex.agent_result" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "const": "json" }
      }
    }
  }
}
