{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebri Operation Journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "runtime_api", "operation_id", "project_id", "descriptor_hash", "approval_id", "lock_path", "state", "stage", "resources", "history", "updated_at"],
  "properties": {
    "schema": { "const": "hebrinex.operation_journal" },
    "contract_version": { "const": "1.0.0" },
    "runtime_api": { "const": "1" },
    "operation_id": { "type": "string" },
    "project_id": { "type": "string" },
    "descriptor_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_id": { "type": "string" },
    "lock_path": { "type": "string" },
    "state": { "enum": ["prepared", "applying", "committed", "rolling_back", "rolled_back", "recovery_required"] },
    "stage": { "type": "string" },
    "resources": { "type": "array", "items": { "type": "object" } },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "at", "evidence"],
        "properties": {
          "state": { "enum": ["prepared", "applying", "committed", "rolling_back", "rolled_back", "recovery_required"] },
          "at": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string" }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
