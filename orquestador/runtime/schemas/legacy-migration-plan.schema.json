{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebrinex Legacy Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "action", "project_id", "instance_id", "source_version", "target_version", "paths", "source_tree_sha256", "source_file_count", "space", "files", "documents", "fixture_mode", "failure_point"],
  "properties": {
    "schema": { "const": "hebrinex.legacy_migration_plan" },
    "schema_version": { "const": 1 },
    "action": { "enum": ["migrate", "restore"] },
    "project_id": { "type": "string", "pattern": "^PRJ-[a-f0-9]{32}$" },
    "instance_id": { "type": "string", "pattern": "^INST-[a-f0-9]{32}$" },
    "legacy_instance_id": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "baseline_path": { "type": "string", "minLength": 1 },
    "baseline_sha256": { "$ref": "#/$defs/sha256" },
    "baseline_source_ref": { "type": "string", "minLength": 1 },
    "snapshot_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "paths": { "type": "object" },
    "source_tree_sha256": { "$ref": "#/$defs/sha256" },
    "source_file_count": { "type": "integer", "minimum": 1 },
    "snapshot_tree_sha256": { "$ref": "#/$defs/sha256" },
    "snapshot_file_count": { "type": "integer", "minimum": 1 },
    "prior_backup_tree_sha256": { "$ref": "#/$defs/sha256" },
    "prior_backup_file_count": { "type": "integer", "minimum": 0 },
    "space": { "$ref": "#/$defs/space" },
    "decisions_hash": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
    "files": { "type": "array", "minItems": 1 },
    "documents": { "type": "object" },
    "stages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollback": { "$ref": "#/$defs/rollback" },
    "approval": { "$ref": "#/$defs/approval" },
    "preserve_post_migration_changes": { "type": "boolean" },
    "fixture_mode": { "type": "boolean" },
    "failure_point": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "migrate" } }, "required": ["action"] },
      "then": {
        "required": ["legacy_instance_id", "baseline_path", "baseline_sha256", "baseline_source_ref", "snapshot_tree_sha256", "snapshot_file_count", "prior_backup_tree_sha256", "prior_backup_file_count", "decisions_hash", "stages", "rollback", "approval"],
        "properties": {
          "paths": { "$ref": "#/$defs/migrate_paths" },
          "files": { "items": { "$ref": "#/$defs/migrate_file" } },
          "documents": { "$ref": "#/$defs/migrate_documents" },
          "failure_point": { "enum": ["", "during_staging", "after_snapshot", "before_publish", "after_publish", "catalog"] }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "restore" } }, "required": ["action"] },
      "then": {
        "required": ["snapshot_manifest_sha256", "preserve_post_migration_changes", "stages", "rollback", "approval"],
        "properties": {
          "paths": { "$ref": "#/$defs/restore_paths" },
          "files": { "items": { "$ref": "#/$defs/snapshot_file" } },
          "documents": { "$ref": "#/$defs/restore_documents" },
          "failure_point": { "enum": ["", "before_publish", "after_preserve", "after_publish"] }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_bytes", "available_bytes"],
      "properties": {
        "required_bytes": { "type": "integer", "minimum": 0 },
        "available_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_publication", "after_publication", "deletes_backups"],
      "properties": {
        "before_publication": { "type": "string", "minLength": 1 },
        "after_publication": { "type": "string", "minLength": 1 },
        "deletes_backups": { "const": false }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "type", "bound_to", "single_use"],
      "properties": {
        "required": { "const": true },
        "type": { "const": "APR2" },
        "bound_to": { "const": "descriptor_hash" },
        "single_use": { "const": true }
      }
    },
    "migrate_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_root", "stage_root", "operation_root", "control_root", "snapshot_path", "snapshot_manifest_path", "prior_backups_path", "prior_backups_manifest_path", "catalog_path"],
      "properties": {
        "legacy_root": { "type": "string", "minLength": 1 },
        "stage_root": { "type": "string", "minLength": 1 },
        "operation_root": { "type": "string", "minLength": 1 },
        "control_root": { "type": "string", "minLength": 1 },
        "snapshot_path": { "type": "string", "minLength": 1 },
        "snapshot_manifest_path": { "type": "string", "minLength": 1 },
        "prior_backups_path": { "type": "string", "minLength": 1 },
        "prior_backups_manifest_path": { "type": "string", "minLength": 1 },
        "catalog_path": { "type": "string", "minLength": 1 }
      }
    },
    "restore_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_root", "stage_root", "operation_root", "control_root", "snapshot_path", "snapshot_manifest_path", "preserved_root", "catalog_path"],
      "properties": {
        "legacy_root": { "type": "string", "minLength": 1 },
        "stage_root": { "type": "string", "minLength": 1 },
        "operation_root": { "type": "string", "minLength": 1 },
        "control_root": { "type": "string", "minLength": 1 },
        "snapshot_path": { "type": "string", "minLength": 1 },
        "snapshot_manifest_path": { "type": "string", "minLength": 1 },
        "preserved_root": { "type": "string", "minLength": 1 },
        "catalog_path": { "type": "string", "minLength": 1 }
      }
    },
    "migrate_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "path_token", "sha256", "size", "baseline_sha256", "classification", "disposition", "destination"],
      "properties": {
        "path": { "type": "string" },
        "path_token": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "baseline_sha256": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
        "classification": { "enum": ["intact", "modified", "local", "unknown", "personal", "generated"] },
        "disposition": { "enum": ["central_reference", "identity_record", "instance_copy", "preserve", "snapshot_only", "deduplicated", "external_backup"] },
        "destination": { "type": "string" }
      }
    },
    "snapshot_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "migrate_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "instance", "registration", "catalog", "origin"],
      "properties": {
        "binding": { "type": "object" },
        "instance": { "type": "object" },
        "registration": { "type": "object" },
        "catalog": { "type": "object" },
        "origin": { "type": "object" }
      }
    },
    "restore_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog"],
      "properties": { "catalog": { "type": "object" } }
    }
  }
}
