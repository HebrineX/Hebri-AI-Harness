{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebri Runtime Active Session",
  "type": "object",
  "required": ["schema", "version", "harness_version", "binding_status", "mode", "chat_role", "non_authoritative"],
  "properties": {
    "schema": { "const": "hebrinex.runtime.active_session" },
    "version": { "type": "string" },
    "harness_version": { "const": "0.10.7" },
    "binding_status": { "enum": ["source_template", "bound", "missing", "mismatch"] },
    "mode": { "enum": ["manual", "automatico"] },
    "chat_role": { "const": "interpreter" },
    "non_authoritative": { "const": true }
  }
}
