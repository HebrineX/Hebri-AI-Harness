{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebrinex Payload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "harness_version", "runtime_api", "architecture", "source_manifest_sha256", "layout_sha256", "tree_sha256", "features", "files"],
  "properties": {
    "schema": { "const": "hebrinex.payload_manifest" },
    "schema_version": { "const": 1 },
    "harness_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "runtime_api": { "type": "string", "pattern": "^[0-9]+$" },
    "architecture": { "const": "x64" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "layout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "mcp"],
      "properties": {
        "core": { "const": true },
        "mcp": { "const": false }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source_path", "class", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "class": { "enum": ["product", "template", "generated"] },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
