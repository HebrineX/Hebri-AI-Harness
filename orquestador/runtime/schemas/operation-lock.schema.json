{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hebri Operation Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "runtime_api", "lock_id", "operation_id", "project_id", "approval_id", "descriptor_hash", "resources", "owner", "created_at", "expires_at", "status"],
  "properties": {
    "schema": { "const": "hebrinex.operation_lock" },
    "contract_version": { "const": "1.0.0" },
    "runtime_api": { "const": "1" },
    "lock_id": { "type": "string", "pattern": "^OPLOCK-[A-Za-z0-9]+$" },
    "operation_id": { "type": "string" },
    "project_id": { "type": "string" },
    "approval_id": { "type": "string", "pattern": "^APR2-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "descriptor_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "process_start_utc", "process_name", "machine_name"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "process_start_utc": { "type": "string", "format": "date-time" },
        "process_name": { "type": "string", "minLength": 1 },
        "machine_name": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "released", "recovered"] },
    "released_at": { "type": "string", "format": "date-time" },
    "recovered_at": { "type": "string", "format": "date-time" }
  }
}
