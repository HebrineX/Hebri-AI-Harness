{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '__HEBRINEX_INSTALL_ROOT__/scripts/claude-reentry.ps1' -RuntimeMode central_instance -InstallRoot '__HEBRINEX_INSTALL_ROOT__' -ProjectRoot '.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '__HEBRINEX_INSTALL_ROOT__/scripts/claude-pretooluse-hook.ps1' -RuntimeMode central_instance -InstallRoot '__HEBRINEX_INSTALL_ROOT__' -ProjectRoot '.'"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '__HEBRINEX_INSTALL_ROOT__/scripts/claude-writeguard-hook.ps1' -RuntimeMode central_instance -InstallRoot '__HEBRINEX_INSTALL_ROOT__' -ProjectRoot '.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '__HEBRINEX_INSTALL_ROOT__/scripts/claude-stop-hook.ps1' -RuntimeMode central_instance -InstallRoot '__HEBRINEX_INSTALL_ROOT__' -ProjectRoot '.'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '__HEBRINEX_INSTALL_ROOT__/scripts/claude-precompact-hook.ps1' -RuntimeMode central_instance -InstallRoot '__HEBRINEX_INSTALL_ROOT__' -ProjectRoot '.'"
          }
        ]
      }
    ]
  }
}
