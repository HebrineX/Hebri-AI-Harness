{
  "$schema": "../orquestador/runtime/schemas/runtime-layout.schema.json",
  "schema": "hebrinex.runtime.layout",
  "schema_version": 1,
  "contract_version": "1.0.0",
  "runtime_api": "1",
  "harness_version": "0.17.1",
  "default_class": "denied",
  "roots": {
    "InstallRoot": { "authority": "trusted_launcher", "consumer_write": false },
    "ProjectRoot": { "authority": "validated_binding", "consumer_write": true },
    "InstanceRoot": { "authority": "derived_from_project", "consumer_write": true },
    "CatalogRoot": { "authority": "current_user_runtime", "consumer_write": true }
  },
  "integrity": {
    "required_files": [
      "HARNESS_VERSION",
      "SHARED_MANIFEST.yaml",
      "scripts/lib/hebri-common.psm1",
      "packaging/runtime-layout.json"
    ]
  },
  "rules": [
    { "id": "DENY-GIT", "match": "prefix", "logical_path": ".git", "class": "denied", "purpose": "external_vcs", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "excluded" },
    { "id": "DENY-CODEX", "match": "prefix", "logical_path": ".codex", "class": "denied", "purpose": "host_local", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "excluded" },
    { "id": "DENY-NODE-MODULES", "match": "prefix", "logical_path": "mcp/node_modules", "class": "denied", "purpose": "dependency_cache", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "excluded" },
    { "id": "DENY-PERSONAL", "match": "exact", "logical_path": "infoHebri.md", "class": "denied", "purpose": "personal_local", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "excluded" },
    { "id": "DENY-PERSONAL-HARNESS", "match": "exact", "logical_path": "infoHebriHarness.md", "class": "denied", "purpose": "personal_local", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "excluded" },
    { "id": "DENY-CLAUDE-LOCAL", "match": "exact", "logical_path": ".claude/settings.local.json", "class": "denied", "purpose": "host_local_override", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "excluded" },
    { "id": "DENY-GITATTRIBUTES", "match": "exact", "logical_path": ".gitattributes", "class": "denied", "purpose": "source_repository_metadata", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-SOURCE-GITIGNORE", "match": "exact", "logical_path": ".gitignore", "class": "denied", "purpose": "source_repository_metadata", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-MIXED-ORCHESTRATOR", "match": "exact", "logical_path": "orquestador", "class": "denied", "purpose": "mixed_container", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-MIXED-MEMORY", "match": "exact", "logical_path": "orquestador/memory", "class": "denied", "purpose": "mixed_container", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-MIXED-SDD", "match": "exact", "logical_path": "orquestador/sdd", "class": "denied", "purpose": "mixed_container", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-MIXED-MIGRATION", "match": "exact", "logical_path": "orquestador/migration", "class": "denied", "purpose": "mixed_container", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-MIXED-RUNTIME", "match": "exact", "logical_path": "orquestador/runtime", "class": "denied", "purpose": "mixed_container", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-BUILD-LAUNCHER", "match": "exact", "logical_path": "scripts/build-launcher.ps1", "class": "denied", "purpose": "source_build_tool", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-BUILD-BASELINES", "match": "exact", "logical_path": "scripts/build-legacy-baselines.ps1", "class": "denied", "purpose": "source_build_tool", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-BUILD-MSI", "match": "exact", "logical_path": "scripts/build-msi.ps1", "class": "denied", "purpose": "source_build_tool", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-BUILD-PAYLOAD", "match": "exact", "logical_path": "scripts/build-payload.ps1", "class": "denied", "purpose": "source_build_tool", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },
    { "id": "DENY-VALIDATE-PACKAGING", "match": "exact", "logical_path": "scripts/validate-packaging.ps1", "class": "denied", "purpose": "source_build_validation", "root": "none", "target_path": "", "read": false, "write": false, "legacy_projection": "none" },

    { "id": "TPL-MCP-CONFIG", "match": "exact", "logical_path": ".mcp.json", "class": "template", "purpose": "host_config_seed", "root": "InstallRoot", "target_path": ".mcp.json", "read": true, "write": false, "legacy_projection": "none" },
    { "id": "TPL-INSTANCE-README", "match": "exact", "logical_path": "instance/README.md", "class": "template", "purpose": "instance_documentation_seed", "root": "InstallRoot", "target_path": "instance/README.md", "read": true, "write": false, "legacy_projection": "none" },
    { "id": "TPL-ACTIVE-SESSION", "match": "exact", "logical_path": "orquestador/runtime/active-session.template.json", "class": "template", "purpose": "runtime_seed", "root": "InstallRoot", "target_path": "orquestador/runtime/active-session.template.json", "read": true, "write": false, "legacy_projection": "none" },
    { "id": "TPL-RUNTIME", "match": "prefix", "logical_path": "orquestador/runtime/templates", "class": "template", "purpose": "runtime_seed", "root": "InstallRoot", "target_path": "orquestador/runtime/templates", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "TPL-PROGRESS", "match": "prefix", "logical_path": "orquestador/sdd/progress/templates", "class": "template", "purpose": "progress_seed", "root": "InstallRoot", "target_path": "orquestador/sdd/progress/templates", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "TPL-SPECS", "match": "prefix", "logical_path": "orquestador/sdd/specs/_template", "class": "template", "purpose": "spec_seed", "root": "InstallRoot", "target_path": "orquestador/sdd/specs/_template", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "TPL-MIGRATION-REPORT", "match": "exact", "logical_path": "orquestador/migration/reports/migration-report.template.yaml", "class": "template", "purpose": "migration_report_seed", "root": "InstallRoot", "target_path": "orquestador/migration/reports/migration-report.template.yaml", "read": true, "write": false, "legacy_projection": "none" },

    { "id": "INST-ROOT", "match": "exact", "logical_path": "instance", "class": "instance", "purpose": "instance_root", "root": "InstanceRoot", "target_path": ".", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-LEGACY-BINDING", "match": "exact", "logical_path": "PROJECT_BINDING.yaml", "class": "instance", "purpose": "legacy_binding", "root": "InstanceRoot", "target_path": "PROJECT_BINDING.yaml", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-PROGRESS", "match": "exact", "logical_path": "PROGRESS.md", "class": "instance", "purpose": "project_progress", "root": "InstanceRoot", "target_path": "PROGRESS.md", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-CONTEXT", "match": "prefix", "logical_path": "orquestador/context", "class": "instance", "purpose": "project_context", "root": "InstanceRoot", "target_path": "context", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MEMORY-REGISTRY", "match": "exact", "logical_path": "orquestador/memory/memory-registry.yaml", "class": "instance", "purpose": "memory_registry", "root": "InstanceRoot", "target_path": "memory/memory-registry.yaml", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MEMORY-LOCAL", "match": "prefix", "logical_path": "orquestador/memory/local", "class": "instance", "purpose": "session_memory", "root": "InstanceRoot", "target_path": "memory/local", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MEMORY-PROJECT", "match": "prefix", "logical_path": "orquestador/memory/project", "class": "instance", "purpose": "project_memory", "root": "InstanceRoot", "target_path": "memory/project", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MEMORY-CYCLE", "match": "prefix", "logical_path": "orquestador/memory/cycle", "class": "instance", "purpose": "cycle_memory", "root": "InstanceRoot", "target_path": "memory/cycle", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MEMORY-DAILY", "match": "prefix", "logical_path": "orquestador/memory/daily", "class": "instance", "purpose": "daily_memory", "root": "InstanceRoot", "target_path": "memory/daily", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MEMORY-COMPLETE", "match": "prefix", "logical_path": "orquestador/memory/complete", "class": "instance", "purpose": "complete_memory", "root": "InstanceRoot", "target_path": "memory/complete", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-PROGRESS-TREE", "match": "prefix", "logical_path": "orquestador/sdd/progress", "class": "instance", "purpose": "runtime_progress", "root": "InstanceRoot", "target_path": "sdd/progress", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-SPECS", "match": "prefix", "logical_path": "orquestador/sdd/specs", "class": "instance", "purpose": "project_specs", "root": "InstanceRoot", "target_path": "sdd/specs", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-BACKUPS", "match": "prefix", "logical_path": "orquestador/migration/backups", "class": "instance", "purpose": "backup", "root": "InstanceRoot", "target_path": "migration/backups", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-POST-MIGRATION", "match": "exact", "logical_path": "orquestador/migration/contracts/post-migration-contract.yaml", "class": "instance", "purpose": "applied_contract", "root": "InstanceRoot", "target_path": "migration/contracts/post-migration-contract.yaml", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-REPORTS", "match": "prefix", "logical_path": "orquestador/migration/reports", "class": "instance", "purpose": "generated_report", "root": "InstanceRoot", "target_path": "migration/reports", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-OP-APPROVALS", "match": "prefix", "logical_path": "orquestador/runtime/operation-approvals", "class": "instance", "purpose": "scoped_approvals", "root": "InstanceRoot", "target_path": "runtime/approvals", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-OP-LOCKS", "match": "prefix", "logical_path": "orquestador/runtime/operation-locks", "class": "instance", "purpose": "operation_locks", "root": "InstanceRoot", "target_path": "runtime/locks", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-OP-JOURNALS", "match": "prefix", "logical_path": "orquestador/runtime/operation-journals", "class": "instance", "purpose": "operation_journals", "root": "InstanceRoot", "target_path": "runtime/journals", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-OP-RESULTS", "match": "prefix", "logical_path": "orquestador/runtime/operation-results", "class": "instance", "purpose": "operation_results", "root": "InstanceRoot", "target_path": "runtime/results", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-AGENT-TASK-PACKS", "match": "prefix", "logical_path": "orquestador/runtime/agent-task-packs", "class": "instance", "purpose": "validated_agent_task_packs", "root": "InstanceRoot", "target_path": "runtime/agent-task-packs", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-CONTEXT-LOAD-REPORTS", "match": "prefix", "logical_path": "orquestador/runtime/context-load-reports", "class": "instance", "purpose": "context_provenance_reports", "root": "InstanceRoot", "target_path": "runtime/context-load-reports", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-AGENT-RESULTS", "match": "prefix", "logical_path": "orquestador/runtime/agent-results", "class": "instance", "purpose": "verifiable_agent_results", "root": "InstanceRoot", "target_path": "runtime/agent-results", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-AGENT-HANDOFFS", "match": "prefix", "logical_path": "orquestador/runtime/agent-handoffs", "class": "instance", "purpose": "cold_agent_handoffs", "root": "InstanceRoot", "target_path": "runtime/agent-handoffs", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-AGENT-EVALUATIONS", "match": "prefix", "logical_path": "orquestador/runtime/agent-evaluations", "class": "instance", "purpose": "provider_evaluation_results", "root": "InstanceRoot", "target_path": "runtime/agent-evaluations", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INST-GATEWAY-RATE", "match": "exact", "logical_path": "orquestador/runtime/gateway-rate.json", "class": "instance", "purpose": "generated_runtime", "root": "InstanceRoot", "target_path": "runtime/gateway-rate.json", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-CLAUDE-RUNTIME", "match": "prefix", "logical_path": "orquestador/runtime/claude", "class": "instance", "purpose": "generated_runtime", "root": "InstanceRoot", "target_path": "runtime/claude", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-MCP-LOCAL", "match": "exact", "logical_path": "mcp/agents-backend.local.yaml", "class": "instance", "purpose": "machine_override", "root": "InstanceRoot", "target_path": "mcp/agents-backend.local.yaml", "read": true, "write": true, "legacy_projection": "instance" },
    { "id": "INST-CENTRAL-BINDING", "match": "exact", "logical_path": "@binding/central", "class": "instance", "purpose": "binding_identity", "root": "ProjectRoot", "target_path": ".hebrinex/binding.json", "read": true, "write": true, "legacy_projection": "none" },

    { "id": "INT-CLAUDE-MD", "match": "exact", "logical_path": "@integration/claude-md", "class": "integration", "purpose": "generated_host_config", "root": "ProjectRoot", "target_path": "CLAUDE.md", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INT-CLAUDE-SETTINGS", "match": "exact", "logical_path": "@integration/claude-settings", "class": "integration", "purpose": "generated_host_config", "root": "ProjectRoot", "target_path": ".claude/settings.json", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INT-CLAUDE-AGENT", "match": "prefix", "logical_path": "@integration/claude-agent", "class": "integration", "purpose": "generated_host_config", "root": "ProjectRoot", "target_path": ".claude/agents", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INT-CURSOR", "match": "exact", "logical_path": "@integration/cursor-rule", "class": "integration", "purpose": "generated_host_config", "root": "ProjectRoot", "target_path": ".cursor/rules/hebrinex.mdc", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INT-COPILOT", "match": "exact", "logical_path": "@integration/copilot-instructions", "class": "integration", "purpose": "generated_host_config", "root": "ProjectRoot", "target_path": ".github/copilot-instructions.md", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "INT-GITIGNORE", "match": "exact", "logical_path": "@integration/project-gitignore", "class": "integration", "purpose": "generated_host_config", "root": "ProjectRoot", "target_path": ".gitignore", "read": true, "write": true, "legacy_projection": "none" },

    { "id": "CAT-PROJECTS", "match": "prefix", "logical_path": "@catalog/projects", "class": "catalog", "purpose": "project_index", "root": "CatalogRoot", "target_path": "projects", "read": true, "write": true, "legacy_projection": "none" },
    { "id": "CAT-LOGS", "match": "prefix", "logical_path": "@catalog/logs", "class": "catalog", "purpose": "generated_diagnostic", "root": "CatalogRoot", "target_path": "logs", "read": true, "write": true, "legacy_projection": "none" },

    { "id": "PROD-AGENTS", "match": "prefix", "logical_path": "agents", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "agents", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-MCP", "match": "prefix", "logical_path": "mcp", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "mcp", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-PROMPTS", "match": "prefix", "logical_path": "prompts", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "prompts", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-SCRIPTS", "match": "prefix", "logical_path": "scripts", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "scripts", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-ADAPTERS", "match": "prefix", "logical_path": "orquestador/adapters", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/adapters", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-AGENT-CONTRACTS", "match": "prefix", "logical_path": "orquestador/agents", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/agents", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-ENTRYPOINTS", "match": "prefix", "logical_path": "orquestador/entrypoints", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/entrypoints", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-INSTRUCTION-BUILDER", "match": "prefix", "logical_path": "orquestador/instruction-builder", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/instruction-builder", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-INTEGRATION-SOURCES", "match": "prefix", "logical_path": "orquestador/integrations", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/integrations", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-METHOD", "match": "prefix", "logical_path": "orquestador/method", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/method", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-MIGRATION-CONTRACTS", "match": "prefix", "logical_path": "orquestador/migration/contracts", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/migration/contracts", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-MIGRATION-BASELINES", "match": "prefix", "logical_path": "orquestador/migration/baselines", "class": "product", "purpose": "trusted_legacy_baseline", "root": "InstallRoot", "target_path": "orquestador/migration/baselines", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-MIGRATION-VERSIONS", "match": "prefix", "logical_path": "orquestador/migration/versions", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/migration/versions", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-POLICIES", "match": "prefix", "logical_path": "orquestador/policies", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/policies", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-PORTABILITY", "match": "prefix", "logical_path": "orquestador/portability", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/portability", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-RUNTIME-SCHEMAS", "match": "prefix", "logical_path": "orquestador/runtime/schemas", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/runtime/schemas", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-PROGRESS-SCHEMAS", "match": "prefix", "logical_path": "orquestador/sdd/progress/schemas", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/sdd/progress/schemas", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-SECURITY", "match": "prefix", "logical_path": "orquestador/security", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/security", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-TESTING", "match": "prefix", "logical_path": "orquestador/testing", "class": "product", "purpose": "shared", "root": "InstallRoot", "target_path": "orquestador/testing", "read": true, "write": false, "legacy_projection": "shared" },
    { "id": "PROD-EVALUATION", "match": "prefix", "logical_path": "orquestador/evaluation", "class": "product", "purpose": "shared_evaluation_contracts", "root": "InstallRoot", "target_path": "orquestador/evaluation", "read": true, "write": false, "legacy_projection": "none" },

    { "id": "PROD-AGENTS-ROOT", "match": "exact", "logical_path": "AGENTS.md", "class": "product", "purpose": "contract", "root": "InstallRoot", "target_path": "AGENTS.md", "read": true, "write": false, "legacy_projection": "none" },
    { "id": "PROD-CHANGELOG", "match": "exact", "logical_path": "CHANGELOG.md", "class": "product", "purpose": "documentation", "root": "InstallRoot", "target_path": "CHANGELOG.md", "read": true, "write": false, "legacy_projection": "none" },
    { "id": "PROD-VERSION", "match": "exact", "logical_path": "HARNESS_VERSION", "class": "product", "purpose": "version", "root": "InstallRoot", "target_path": "HARNESS_VERSION", "read": true, "write": false, "legacy_projection": "none" },
